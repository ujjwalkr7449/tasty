# Copy this file to .env. Never commit your real API key.
RESEND_API_KEY=re_replace_with_your_new_key
# The inbox that receives new-order notifications.
ORDER_NOTIFICATION_EMAIL=your-email@example.com
# While testing, Resend supports its onboarding sender for your account email.
# Replace with a sender on your verified domain before public launch.
ORDER_FROM_EMAIL=Tasty Orders <onboarding@resend.dev>
